{
  "name": "skaftor",
  "version": "0.2.0",
  "description": "Command-line client for Skaftor — drive AI-native software delivery work orders from your terminal over MCP.",
  "type": "module",
  "bin": {
    "skaftor": "bin/skaftor.mjs"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/",
    "smoke": "node bin/skaftor.mjs --version && node bin/skaftor.mjs help >/dev/null",
    "lint": "node --check bin/skaftor.mjs && node --check bin/ws.mjs"
  },
  "keywords": [
    "skaftor",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai-native",
    "sdlc",
    "coding-agents",
    "work-orders",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaftor/skaftor-cli.git"
  },
  "homepage": "https://skaftor.com",
  "bugs": {
    "url": "https://github.com/skaftor/skaftor-cli/issues"
  },
  "author": "Skaftor",
  "license": "MIT"
}
